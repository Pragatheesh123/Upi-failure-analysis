{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.4.0/schema.json",
  "name": "matrix",
  "position": {
    "x": 20,
    "y": 365,
    "z": 0,
    "width": 1240,
    "height": 225,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "pivotTable",
    "query": {
      "queryState": {
        "Rows": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "bank_details"
                    }
                  },
                  "Property": "bank_group"
                }
              },
              "queryRef": "bank_details.bank_group",
              "nativeQueryRef": "bank_group",
              "displayName": "Bank group"
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "bank_details"
                    }
                  },
                  "Property": "year"
                }
              },
              "queryRef": "bank_details.year",
              "nativeQueryRef": "year",
              "displayName": "Year"
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "bank_details"
                    }
                  },
                  "Property": "System fail %"
                }
              },
              "queryRef": "bank_details.System fail %",
              "nativeQueryRef": "System fail %"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "bank_details"
                    }
                  },
                  "Property": "Banks"
                }
              },
              "queryRef": "bank_details.Banks",
              "nativeQueryRef": "Banks"
            }
          ]
        }
      }
    },
    "objects": {
      "values": [
        {
          "properties": {
            "backColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Measure": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "bank_details"
                        }
                      },
                      "Property": "System fail colour"
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "data": [
              {
                "dataViewWildcard": {
                  "matchingOption": 1
                }
              }
            ],
            "metadata": "bank_details.System fail %"
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'System fail % and number of banks, by group and year'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
