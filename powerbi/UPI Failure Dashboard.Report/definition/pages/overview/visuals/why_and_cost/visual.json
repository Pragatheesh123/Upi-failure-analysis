              {
                "textRuns": [
                  {
                    "value": "Why did it change?",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#1F3A5F",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Banks really improved: almost all of the drop in system failures came from banks' own rates, not from payments moving to better banks.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F3A5F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Half of the 2022-2025 rise in user failures came from payments moving to payments banks with high user failures (India Post, Airtel) as Paytm Payments Bank left.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F3A5F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F3A5F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "What does it cost?",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#1F3A5F",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Last 12 months: 819.7 mn payments failed for system reasons.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F3A5F"
                    }
