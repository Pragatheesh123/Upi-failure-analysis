table events

	column month
		dataType: string
		summarizeBy: none
		sourceColumn: month

	column event
		dataType: string
		summarizeBy: none
		sourceColumn: event

	column source
		dataType: string
		summarizeBy: none
		sourceColumn: source

	partition events = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:\upi failure\powerbi\data\events.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"month", "event", "source"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"month", type text}, {"event", type text}, {"source", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
