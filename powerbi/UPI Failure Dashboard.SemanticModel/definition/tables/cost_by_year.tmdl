table cost_by_year

	measure 'All failed, full years (mn)' = IF(SELECTEDVALUE(cost_by_year[year]) <> "2026", SUM(cost_by_year[system_failed_mn]))
		formatString: #,0

	measure 'Checkout, full years (mn)' = IF(SELECTEDVALUE(cost_by_year[year]) <> "2026", SUM(cost_by_year[checkout_payments_hit_mn]))
		formatString: #,0

	measure 'All failed, 2026 Jan-Sep (mn)' = IF(SELECTEDVALUE(cost_by_year[year]) = "2026", SUM(cost_by_year[system_failed_mn]))
		formatString: #,0

	measure 'Checkout, 2026 Jan-Sep (mn)' = IF(SELECTEDVALUE(cost_by_year[year]) = "2026", SUM(cost_by_year[checkout_payments_hit_mn]))
		formatString: #,0

	column year
		dataType: string
		summarizeBy: none
		sourceColumn: year

	column year_label
		dataType: string
		sortByColumn: year
		summarizeBy: none
		sourceColumn: year_label

	column system_failed_mn
		dataType: double
		formatString: #,0
		summarizeBy: sum
		sourceColumn: system_failed_mn

	column checkout_payments_hit_mn
		dataType: double
		formatString: #,0
		summarizeBy: sum
		sourceColumn: checkout_payments_hit_mn

	partition cost_by_year = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:\upi failure\powerbi\data\cost_by_year.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"year", "year_label", "system_failed_mn", "checkout_payments_hit_mn"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"year", type text}, {"year_label", type text}, {"system_failed_mn", type number}, {"checkout_payments_hit_mn", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
